    {
      "parameters": {
        "jsCode": "const S = v => (v == null ? '' : String(v)).trim();\nconst N = v => { const n = parseInt(String(v).replace(/[, ]/g, ''), 10); return isNaN(n) ? 0 : n; };\nconst rows = $input.all().map(i => i.json);\nconst corpus = [], visual = [], audience = [];\nfor (const r of rows) {\n  const id = S(r.id) || ('row_' + Math.random().toString(36).slice(2, 10));\n  const mtype = S(r.media_type).toLowerCase();\n  const author = (S(r.author) || 'creator').toLowerCase();\n  if (mtype === 'comment' && author === 'audience') {\n    audience.push({ id, platform: S(r.platform), text: S(r.caption) || S(r._transcript) || S(r.transcript), likes: N(r.likes) });\n    continue;\n  }\n  if (r._visual_desc) visual.push({ id, platform: S(r.platform), media_type: mtype, visual_desc: S(r._visual_desc) });\n  let caption = S(r.caption) || null;\n  if (r._overlay) caption = (caption ? caption + ' ' : '') + S(r._overlay);\n  const transcript = S(r._transcript) || S(r.transcript) || null;\n  const title = S(r.title) || null;\n  if (!(transcript || caption || title)) continue;\n  const hook = S(r.hook) || (transcript || caption || '').replace(/\\n/g, ' ').split('. ')[0].split(' ').slice(0, 14).join(' ');\n  corpus.push({ id, platform: S(r.platform), media_type: mtype, title, transcript, caption, hook,\n    published_at: S(r.published_at) || null,\n    metrics: { views: N(r.views), likes: N(r.likes), comments: N(r.comments) }, performance_percentile: 0 });\n}\nconst scored = corpus.map(i => (i.metrics.likes + i.metrics.comments) / Math.max(i.metrics.views, 1));\nconst sorted = [...scored].sort((a, b) => a - b);\ncorpus.forEach((it, k) => { const rank = sorted.filter(v => v <= scored[k]).length;\n  it.performance_percentile = corpus.length ? Math.round((rank / corpus.length) * 1000) / 1000 : 0; });\nconst c0 = rows[0] || {};\nconst corpusDoc = { creator: { handle: S(c0.creator || c0.handle), niche: S(c0.niche),\n  platforms: [...new Set(corpus.map(i => i.platform).filter(Boolean))] }, items: corpus };\nreturn [\n  { json: { fileName: 'corpus.json',           fileContent: JSON.stringify(corpusDoc, null, 2) } },\n  { json: { fileName: 'visual_profile.json',   fileContent: JSON.stringify({ items: visual }, null, 2) } },\n  { json: { fileName: 'audience_signals.json', fileContent: JSON.stringify({ items: audience }, null, 2) } },\n];"
      },
