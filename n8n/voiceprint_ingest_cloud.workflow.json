    {
      "parameters": {
        "jsCode": "const row = { ...$('Read creator sheet').item.json };\nconst transcript = String(($('STT · video').item.json.text) || '').trim() || null;\nconst out = String(($json && $json.output) || '');\nconst i = out.indexOf('TEXT:');\nlet vd = null, ov = null;\nif (i >= 0) { vd = out.slice(0, i).trim() || null; ov = out.slice(i + 5).trim() || null; }\nelse { vd = out.trim() || null; }\nrow._transcript = transcript; row._visual_desc = vd; row._overlay = ov;\nreturn [{ json: row }];"
      },
