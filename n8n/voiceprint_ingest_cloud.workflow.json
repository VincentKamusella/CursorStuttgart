        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ video_url: $('Read creator sheet').item.json.media_url, prompt: \"Describe the visual style and what happens in this short video in one or two sentences for a creator style profile, then on a new line prefixed TEXT: transcribe any on-screen text overlays verbatim. If none, write TEXT:\", model: \"google/gemini-2.5-flash\" }) }}",
