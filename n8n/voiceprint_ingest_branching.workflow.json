              "name": "Authorization",
              "value": "=Key {{ $env.FAL_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ image_url: $json.media_url, prompt: \"Describe this social-media image in one sentence for a creator style profile, then on a new line prefixed TEXT: transcribe verbatim any text overlaid on the image (captions, stickers, titles). If there is no overlaid text, write TEXT:\" }) }}",
        "options": {
          "timeout": 120000
        }
