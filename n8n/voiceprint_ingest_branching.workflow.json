      "id": "vision",
      "name": "fal · Vision (image→text+OCR)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        900,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "// video/audio branch: fold Wizper transcript back onto the original sheet row\nconst r = { ...$('Read creator sheet').item.json };\nconst res = $json || {};\nr._transcript = (res.text ? String(res.text).trim() : '') || null;\nr._visual_desc = null;\nr._overlay = null;\nreturn [{ json: r }];"
      },
      "id": "shapeSTT",
      "name": "Shape transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// image/story branch: split \"<desc>\\nTEXT:<overlay>\" from the VLM, fold onto row\nconst r = { ...$('Read creator sheet').item.json };\nconst res = $json || {};\nconst txt = String(res.output || res.text || res.response || res.content || '');\nconst idx = txt.indexOf('TEXT:');\nlet vd = null, ov = null;\nif (idx >= 0) { vd = txt.slice(0, idx).trim() || null; ov = txt.slice(idx + 5).trim() || null; }\nelse { vd = txt.trim() || null; }\nr._transcript = (String(r.transcript || '').trim()) || null;\nr._visual_desc = vd;\nr._overlay = ov;\nreturn [{ json: r }];"
      },
      "id": "shapeVision",
      "name": "Shape visual + OCR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "// comment branch: passes straight through from the Switch, just normalise fields\nconst r = { ...$json };\nr._transcript = (String(r.transcript || '').trim()) || null;\nr._visual_desc = null;\nr._overlay = null;\nreturn [{ json: r }];"
      },
      "id": "shapeComment",
      "name": "Shape comment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        640
      ]
    },
    {
      "parameters": {
        "numberInputs": 3
      },
      "id": "merge",
      "name": "Merge branches",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1380,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "// Collect every enriched row from the Merge, split into the three buckets,\n// compute engagement-rate percentile, emit one JSON file per bucket.\nconst S = v => (v == null ? '' : String(v)).trim();\nconst N = v => { const n = parseInt(String(v).replace(/[, ]/g, ''), 10); return isNaN(n) ? 0 : n; };\n\nconst rows = $input.all().map(i => i.json);\nconst corpus = [], visual = [], audience = [];\n\nfor (const r of rows) {\n  const id = S(r.id) || ('row_' + Math.random().toString(36).slice(2, 10));\n  const mtype = S(r.media_type).toLowerCase();\n  const author = (S(r.author) || 'creator').toLowerCase();\n\n  if (mtype === 'comment' && author === 'audience') {\n    audience.push({ id, platform: S(r.platform), text: S(r.caption) || S(r._transcript) || S(r.transcript), likes: N(r.likes) });\n    continue;\n  }\n\n  if (r._visual_desc) visual.push({ id, platform: S(r.platform), visual_desc: S(r._visual_desc) });\n\n  let caption = S(r.caption) || null;\n  if (r._overlay) caption = (caption ? caption + ' ' : '') + S(r._overlay);\n  const transcript = S(r._transcript) || S(r.transcript) || null;\n  const title = S(r.title) || null;\n  if (!(transcript || caption || title)) continue;\n\n  const hook = S(r.hook) || (transcript || caption || '')\n    .replace(/\\n/g, ' ').split('. ')[0].split(' ').slice(0, 14).join(' ');\n\n  corpus.push({\n    id, platform: S(r.platform), title, transcript, caption, hook,\n    published_at: S(r.published_at) || null,\n    metrics: { views: N(r.views), likes: N(r.likes), comments: N(r.comments) },\n    performance_percentile: 0,\n  });\n}\n\nconst scored = corpus.map(i => (i.metrics.likes + i.metrics.comments) / Math.max(i.metrics.views, 1));\nconst sorted = [...scored].sort((a, b) => a - b);\ncorpus.forEach((it, k) => {\n  const rank = sorted.filter(v => v <= scored[k]).length;\n  it.performance_percentile = corpus.length ? Math.round((rank / corpus.length) * 1000) / 1000 : 0;\n});\n\nconst c0 = rows[0] || {};\nconst corpusDoc = {\n  creator: { handle: S(c0.creator || c0.handle), niche: S(c0.niche),\n             platforms: [...new Set(corpus.map(i => i.platform).filter(Boolean))] },\n  items: corpus,\n};\n\nreturn [\n  { json: { fileName: 'corpus.json',           fileContent: JSON.stringify(corpusDoc, null, 2) } },\n  { json: { fileName: 'visual_profile.json',   fileContent: JSON.stringify({ items: visual }, null, 2) } },\n  { json: { fileName: 'audience_signals.json', fileContent: JSON.stringify({ items: audience }, null, 2) } },\n];"
      },
      "id": "assemble",
      "name": "Assemble buckets + percentile",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
