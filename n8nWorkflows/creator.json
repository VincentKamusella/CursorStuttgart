        "id": "dda5683a-be33-4241-a9ea-ee58c3503529",
        "name": "Scrape creator videos (Apify)",
        "credentials": {
          "apifyOAuth2Api": {
            "id": "KBagGEUEu17uFBue",
            "name": "Apify account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "// Map streamers/youtube-scraper dataset items onto the Google Sheets schema.\n// Replaces the old RSS/XML regex parse of the channel feed.\nconst scraped_at = new Date().toISOString();\nconst seeds = $('Creator seed URLs').all();\nconst seed_url = seeds[0]?.json?.creator_url || '';\n\nconst int = (v) => {\n  if (v == null) return null;\n  const n = parseInt(String(v).replace(/[^\\d]/g, ''), 10);\n  return Number.isFinite(n) ? n : null;\n};\nconst vidId = (it) => {\n  if (it.id) return String(it.id);\n  const m = String(it.url || '').match(/(?:v=|\\/shorts\\/|youtu\\.be\\/)([\\w-]{6,})/);\n  return m ? m[1] : '';\n};\n\nconst out = [];\n$input.all().forEach((item, i) => {\n  const it = item.json || {};\n  if (it.error) return;                       // actor reports failures inline\n  const video_id = vidId(it);\n  const video_url = it.url || (video_id ? 'https://www.youtube.com/watch?v=' + video_id : '');\n  if (!video_id && !video_url) return;\n\n  const isShort = /\\/shorts\\//.test(video_url);\n  const chUrl = it.channelUrl || '';\n  const chId = (chUrl.match(/\\/channel\\/(UC[\\w-]+)/) || [])[1] || '';\n\n  out.push({ json: {\n    creator: it.channelName || '',\n    creator_url: chUrl || seed_url,\n    channel_id: chId,\n    video_id,\n    title: it.title || '',\n    video_url,\n    embed_url: video_id ? 'https://www.youtube.com/embed/' + video_id : '',\n    short_url: video_id ? 'https://youtu.be/' + video_id : '',\n    content_type: isShort ? 'short' : 'video',\n    position: i + 1,\n    published_at: it.date || '',\n    updated_at: it.date || '',\n    views: int(it.viewCount),\n    likes: int(it.likes),\n    rating: '',                               // not exposed by this actor\n    image_url: video_id ? `https://i.ytimg.com/vi/${video_id}/maxresdefault.jpg` : '',\n    image_original: video_id ? `https://i.ytimg.com/vi/${video_id}/oardefault.jpg` : '',\n    image_hq: it.thumbnailUrl || (video_id ? `https://i.ytimg.com/vi/${video_id}/hqdefault.jpg` : ''),\n    comments_fetched: 0,\n    top_comments: '',\n    description: String(it.text || '').slice(0, 500),\n    duration: it.duration || '',\n    comments_count: int(it.commentsCount),\n    scraped_at,\n  }});\n});\n\nif (out.length === 0) {\n  throw new Error('YouTube Scraper returned no videos - check the Actor run log in Apify Console.');\n}\n\nout.sort((a, b) => String(b.json.published_at).localeCompare(String(a.json.published_at)));\nreturn out;\n"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          448,
