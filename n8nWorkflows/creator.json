            "value": "h7sDV53CddomktSi5",
            "mode": "list",
            "cachedResultName": "streamers/youtube-scraper"
          },
          "customBody": "={{ JSON.stringify({ startUrls: [{ url: $json.creator_url }], maxResults: 30, maxResultsShorts: 10, sortingOrder: \"date\", downloadSubtitles: false }) }}",
