          "jsCode": "// Creator(s) to crawl. Accepts any YouTube profile form:\n//   https://www.youtube.com/c/name  |  /@handle  |  /channel/UC...  |  /user/name\nconst urls = [\n  'https://www.youtube.com/c/chaosadam13',\n];\n\nconst clean = urls.map(u => String(u || '').trim()).filter(Boolean);\nif (!clean.length) {\n  throw new Error('No creator URL configured. Add at least one profile link to the urls array.');\n}\n\nreturn clean.map(creator_url => ({ json: { creator_url } }));"
