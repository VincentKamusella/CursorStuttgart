        ],
        "id": "14dad9d5-9e17-41dc-a90f-a4d2833e7312",
        "name": "Restructure creator content"
      },
      {
        "parameters": {
          "jsCode": "// The comments Actor accepts many startUrls per run, so batch every video into\n// ONE run instead of paying for one Actor run per video.\nconst urls = $input.all()\n  .map(i => i.json.video_url)\n  .filter(Boolean);\n\nif (!urls.length) throw new Error('No video URLs to fetch comments for.');\n\nreturn [{ json: { video_urls: urls.slice(0, 50) } }];\n"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          672,
          0
        ],
        "id": "053405c4-078c-4c59-ae90-cf421460b55b",
        "name": "Collect video URLs"
      },
      {
        "parameters": {
          "operation": "Run actor and get dataset",
          "actorId": {
            "__rl": true,
            "value": "p7UMdpQnjKmmpR21D",
            "mode": "list",
            "cachedResultName": "streamers/youtube-comments-scraper"
          },
          "customBody": "={{ JSON.stringify({ startUrls: $json.video_urls.map(u => ({ url: u })), maxComments: 10 }) }}",
          "timeout": 600,
          "authentication": "apifyOAuth2Api"
        },
        "type": "@apify/n8n-nodes-apify.apify",
        "typeVersion": 1,
        "position": [
          880,
          0
        ],
        "id": "684c373d-f677-4492-a38e-845537d449c3",
        "name": "Scrape comments (Apify)",
        "credentials": {
          "apifyOAuth2Api": {
            "id": "KBagGEUEu17uFBue",
            "name": "Apify account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "// Group streamers/youtube-comments-scraper output back onto its video row.\n// One Actor run covers every video, so results are keyed by URL, not by index.\nfunction keyOf(u) {\n  const m = String(u || '').match(/(?:v=|\\/shorts\\/|youtu\\.be\\/)([\\w-]{6,})/);\n  return m ? m[1] : '';\n}\n\nconst byVideo = new Map();\nfor (const item of $input.all()) {\n  const c = item.json || {};\n  const k = keyOf(c.videoUrl || c.url || c.video_url);\n  if (!k) continue;\n  const text = String(c.comment ?? c.text ?? '').replace(/\\s+/g, ' ').trim();\n  if (!text) continue;\n  if (!byVideo.has(k)) byVideo.set(k, []);\n  byVideo.get(k).push({\n    author: c.author || c.authorName || '',\n    text,\n    likes: Number(c.voteCount ?? c.likes ?? 0) || 0,\n    replies: Number(c.replyCount ?? c.replies ?? 0) || 0,\n  });\n}\n\nconst fmt = (list, max = 5) => list.slice(0, max)\n  .map(c => `${c.author} (${c.likes}❤): ${c.text}`)\n  .join(' ||| ')\n  .slice(0, 1500);\n\nreturn $('Restructure creator content').all().map(item => {\n  const row = { ...item.json };\n  const list = (byVideo.get(row.video_id) || []).sort((a, b) => b.likes - a.likes);\n  row.comments_fetched = list.length;\n  row.top_comments = fmt(list);\n  return { json: row };\n});\n"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1104,
          0
        ],
