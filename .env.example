# Copy to .env and fill in real values. .env is gitignored — never commit real keys.

# fal.ai — n8n Header Auth credential value:  Key <FAL_KEY>
FAL_KEY=your-fal-key-id:your-fal-key-secret

# Apify — n8n Header Auth credential value:  Bearer <APIFY_TOKEN>
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# n8n Cloud public API base
N8N_API_URL=https://<your-instance>.app.n8n.cloud/api/v1
